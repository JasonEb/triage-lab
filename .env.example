# Copy to .env (git-ignored). Never commit real keys.
# Claude API key for the troubleshooting agent. TRIAGE_ANTHROPIC_API_KEY wins;
# ANTHROPIC_API_KEY is accepted as a fallback for local use. Hosted environments
# such as Claude Code on the web reserve ANTHROPIC_API_KEY, so use the TRIAGE_ name there.
TRIAGE_ANTHROPIC_API_KEY=
# Optional. Defaults to https://api.anthropic.com; ANTHROPIC_BASE_URL is ignored on purpose.
TRIAGE_ANTHROPIC_BASE_URL=

# Troubleshooting agent (Phase 3). All optional.
TRIAGE_MODEL=claude-sonnet-5-5
TRIAGE_EFFORT=medium
TRIAGE_MAX_STEPS=15
TRIAGE_MAX_TOKENS=500000

# Salt for patient ID hashing. Any value works for synthetic data.
TRIAGE_ID_HASH_SALT=
